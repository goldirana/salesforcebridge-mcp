# Salesforce OAuth
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=
SF_CALLBACK_URL=http://localhost:8000/oauth/callback
SF_API_VERSION=v62.0

# Redis (for token/session/cache storage)
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=8000
ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Cache TTLs (seconds)
CACHE_DESCRIBE_TTL=3600
CACHE_QUERY_TTL=300
